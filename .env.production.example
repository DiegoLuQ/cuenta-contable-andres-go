# ============================================================================
# Variables para docker-compose en el servidor de producción (186.64.120.228)
# Copiar como ".env" junto a docker-compose.yml y completar. NO subir a git.
# ============================================================================

# --- MySQL db_central ---
# Si MariaDB corre en Docker dentro de red_produccion, se puede usar el nombre de su contenedor.
MYSQL_HOST=186.64.120.228
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=db_central

# --- Sesiones: mismo valor que SESSION_SECRET del .env local (o uno nuevo de 96 caracteres hex) ---
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- URL pública con https (aparece en el JSON de entrega de las API keys) ---
PUBLIC_URL=https://central.dpmc.cl

# --- Dominio (nginx-proxy + Let's Encrypt) ---
VIRTUAL_HOST=central.dpmc.cl
LETSENCRYPT_HOST=central.dpmc.cl
LETSENCRYPT_EMAIL=
